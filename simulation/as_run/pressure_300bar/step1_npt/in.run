############################################################################################
# LAMMPS input script for NPT simulation of combined graphene-PFH system
# Generated by graphene_PFH_npt_workflow.sh
############################################################################################
dimension       3
units           metal
boundary        p p p
atom_style      full
echo            both

bond_style      harmonic
angle_style     harmonic
dihedral_style  opls

read_data       in.config

include         in.groups
# include         in.varDefs_shortRun
include         in.varDefs
include         in.forcefield

run_style       verlet
neighbor        3.0 bin
neigh_modify    every 10 delay 10 check yes one 10000

##########################################################################################
# STAGE 2: Compress the graphene PFH system using anisotropic z NPT 0 desired pressure #
##########################################################################################

reset_timestep 0

fix  boxnpt all npt  temp ${temp} ${temp} 0.1 x 0 0 1 y 0 0 1 
fix  center all recenter INIT INIT INIT units box

thermo_style    custom step temp pe etotal # zlo zhi v_lz
thermo          ${Nt}
thermo_modify   flush yes
thermo_modify   format line "%d %12.5f %12.5f %12.5e %12.5f %12.5f %12.5f"

dump 1 all custom ${Ndump} dump.npt.lammpstrj id type x y z vx vy vz
dump_modify 1 sort id

variable boxVol equal vol
fix boxSizeStats all ave/time 500 1 500 v_lx v_ly v_lz v_boxVol file out.boxSizes  

# gradual relaxation : Pre-initialization
timestep 1e-5
run ${Npinpt}

timestep 2e-5
run ${Npinpt}

timestep 5e-5
run ${Npinpt}

timestep 1e-4
run ${Npinpt}

timestep 2e-4
run ${Npinpt}

timestep 5e-4
run ${Npinpt}

timestep 1e-3
run ${Npinpt}

# Write a restart file for continuation
restart ${Nrst} restart.npt.*
run ${Ninpt}

unfix   boxnpt
unfix   center 

fix     boxnpt all npt  temp ${temp} ${temp} 0.1 z ${targetPress} ${targetPress} 1
fix     center all recenter INIT INIT INIT units box

run ${Ninpt}

undump 1
unfix  boxSizeStats

reset_timestep 0

fix boxSizeStats all  ave/time ${Nevery1}  ${Nrep1} ${Nfreq1} v_lx v_ly v_lz v_boxVol append out.boxSizes  
fix  avLz        all  ave/time 1           ${Npnpt} ${Npnpt}  v_lz file out.avboxlz

run ${Npnpt}

variable final_zlo equal -0.5*f_avLz
variable final_zhi equal  0.5*f_avLz

unfix  boxnpt
unfix  center

#########################################################
# STAGE 3: Shrink box size ensures the desired pressure #
#########################################################

fix  boxdeform  all deform 10000 z final ${final_zlo} ${final_zhi}

unfix  boxSizeStats
unfix  avLz

reset_timestep 0

fix  pfhnvt PFH    nvt temp ${temp} ${temp} 0.1
fix  lwnvt  lw_all nvt temp ${temp} ${temp} 0.1
fix  rwnvt  rw_all nvt temp ${temp} ${temp} 0.1
fix  center all recenter INIT INIT INIT units box

# dump 1 all custom ${Ndump} dump.stage3.lammpstrj id type x y z vx vy vz
# dump_modify 1 sort id

run ${deformTime}
# undump 1

unfix boxdeform
unfix center 

write_data config.end_of_npt
