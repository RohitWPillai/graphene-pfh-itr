# Dynamically generated group definitions for NPT simulation
#
group   PFH         type  1  2  3
group   lw_all      type  4  5  6  7  8  9 10 11 12
group   rw_all      type 21 20 19 18 17 16 15 14 13

region  lefthalf  block   EDGE EDGE EDGE EDGE ${zL} 0
region  righthalf block   EDGE EDGE EDGE EDGE 0     ${zH}

group   leftAtoms   region lefthalf
group   rightAtoms  region righthalf

group   pfhleft   intersect PFH    leftAtoms    # pfh slab left
group   pfhright  intersect PFH    rightAtoms   # pfh slab right
group   wallleft  intersect lw_all leftAtoms    # left walls of the left half
group   wallright intersect rw_all rightAtoms   # right walls of the right half

# -- CHECK_SUM = 9 groups in total 
