#--------------------------------------------------------------
# Variables for converting real to metal units
# -------------------------------------------------------------

    variable  j_to_ev        equal  6.241509074e18                  # 1 J= ${j_to_ev} eV
    variable  ev_to_j        equal  1./${j_to_ev}                   
    variable  kB_si          equal  1.380649e-23                    # in units of J/K
    variable  kB             equal  ${kB_si}*${j_to_ev}             # boltzmann constant in units of eV/K
    variable  nAv            equal  6.02214076e23                   # Nav in units of mol^{-1}
    variable  j_to_ev        equal  6.241509074e18                  # 1 J= ${j_to_ev} eV
    variable  kcal_to_j      equal  4184                            # kcal to kJ
    variable  kcalmol_to_ev  equal  ${kcal_to_j}*${j_to_ev}/${nAv}  # kcal/mol to ev 
    variable  kJmol_to_ev    equal  1e3*${j_to_ev}/${nAv}           # kJmol to ev
    variable  temp           equal  300                 # temperature
    variable  ang3_to_m3     equal  1e-30                           # ang^3 to m^3
    variable  to_J_m3        equal  ${ev_to_j}/${ang3_to_m3}        # ev/ang^3 to J/m^3
    variable  to_bar         equal  ${to_J_m3}*1e-5                 # Press in bar     

    variable  Nt             equal  1e2                   # Output thermo every ...
    variable  Ndump          equal  1e2                # dump every ...
    variable  Nrst           equal  1e2                 # write restart every ...
    variable  Npinpt         equal  1e2                # initial NPT steps
    variable  Ninpt          equal  1e3            # long NPT steps
    variable  Npnpt          equal  5e2             # transient NPT steps
    variable  deformTime     equal  5e2
    variable  Nfreq1         equal  ${Npnpt}/5           # Divide nvt phase into blocks of 5
    variable  Nrep1          equal  ${Nfreq1}       
    variable  Nevery1        equal  1               

    variable  Nfreq2         equal  ${Npnpt}/5          # Divide nvt phase into blocks of 5
    variable  Nrep2          equal  ${Nfreq2}       
    variable  Nevery2        equal  1               

    variable  lz             equal  zhi-zlo
    variable  lx             equal  xhi-xlo          # edge length in x
    variable  ly             equal  yhi-ylo          # edge length in y
    variable  wallAr         equal  ${lx}*${ly}      # planar area 
