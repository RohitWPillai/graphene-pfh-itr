############################################################################################
# LAMMPS input script for NPT simulation of combined graphene-PFH system
# Generated by graphene_PFH_npt_workflow.sh
############################################################################################

    dimension       3
    units           metal
    boundary        p p p
    atom_style      full
    echo            both

    read_restart    ../step3_nve/restart.nve.*
    # include         in.varDefs_shortRun
    include         in.varDefs
    include         in.forcefield
    include         in.groups

    run_style       verlet
    neighbor        3.0 bin
    neigh_modify    every 10 delay 10 check yes one 10000

    run 0

    reset_timestep  0

##############################################################
# NVT : Create random velocities and perform NVT simulations #
##############################################################

    velocity pfhleft   create ${tempEquil} ${RND1} mom yes rot yes dist gaussian
    velocity wallleft  create ${tempEquil} ${RND2} mom yes rot yes dist gaussian 
    velocity pfhright  create ${tempEquil} ${RND3} mom yes rot yes dist gaussian
    velocity wallright create ${tempEquil} ${RND4} mom yes rot yes dist gaussian 

    compute allmom all momentum

    # define variables for each component:
    variable  px  equal c_allmom[1]
    variable  py  equal c_allmom[2]
    variable  pz  equal c_allmom[3]

    run 0 

    # just print once at setup:
    print "Initial total momentum = ${px} ${py} ${pz}"

    uncompute allmom

    fix  pfhnvt   PFH     nvt temp ${tempEquil} ${tempEquil} $(100.0*dt)
    fix  lwall    lw_all  nvt temp ${tempEquil} ${tempEquil} $(100.0*dt)
    fix  rwall    rw_all  nvt temp ${tempEquil} ${tempEquil} $(100.0*dt)
    fix  center   all     recenter INIT INIT INIT units box

########## PERFORM CHECKS BEFORE RUN ##########
#### [1] check groups and at time = 0 ####

    dump 1 heatReg custom 1 check.heat.lammpstrj id type x y z vx vy vz
    dump_modify 1 sort id

    dump 2 coolRegL custom 1 check.coolL.lammpstrj id type x y z vx vy vz
    dump_modify 2 sort id

    dump 3 coolRegR custom 1 check.coolR.lammpstrj id type x y z vx vy vz
    dump_modify 3 sort id

    dump 4 pfhleft custom 1 check.pfhL.lammpstrj id type x y z vx vy vz
    dump_modify 4 sort id

    dump 5 pfhright custom 1 check.pfhR.lammpstrj id type x y z vx vy vz
    dump_modify 5 sort id

    dump 6 noheat custom 1 check.noheat.lammpstrj id type x y z vx vy vz
    dump_modify 6 sort id

    run 0

    undump 1
    undump 2
    undump 3
    undump 4
    undump 5
    undump 6

###### end of [1] ########

    run ${Npnvt} 

    unfix pfhnvt
    unfix lwall
    unfix rwall
    unfix center 

    fix  pfhnve   PFH     nve 
    fix  lwall    lw_all  nve 
    fix  rwall    rw_all  nve
    fix  center   all     recenter INIT INIT INIT units box

    run ${Npnve}

    unfix pfhnve
    unfix lwall
    unfix rwall
    unfix center 

    velocity lw_all zero linear 
    velocity lw_all zero angular

    velocity rw_all zero linear 
    velocity rw_all zero angular

    velocity PFH   zero linear 
    velocity PFH   zero angular

#################################################################
# Thermalization : Thermostat the therm group and NVE elsewhere #
#################################################################

    reset_timestep  0

    compute allmom all momentum

    # define variables for each component:
    variable  px  equal c_allmom[1]
    variable  py  equal c_allmom[2]
    variable  pz  equal c_allmom[3]

    run 0 

    # just print once at setup:
    print "Initial total momentum before thermalization = ${px} ${py} ${pz}"

    uncompute allmom

    fix  qIn      heatReg nvt temp ${tempHot}  ${tempHot}  ${damp}
    fix  qOut     coolReg nvt temp ${tempCold} ${tempCold} ${damp}
    fix  notherm  noheat  nve
    fix  center   all     recenter INIT INIT INIT units box

#### [2] compute heat fluxes and total energy ####

    variable  keTot equal ke
    variable  peTot equal pe
    variable  eTot  equal etotal
    variable  ecoup equal ecouple
    variable  econs equal econserve

    fix qInOut  all ave/time ${Nt} 1 ${Nt} f_qIn f_qOut file out.qInOut format "%15.5f"
    fix enStats all ave/time ${Nt} 1 ${Nt} v_peTot v_keTot v_eTot v_ecoup v_econs file out.enstats format "%15.5f"

#### end of [2] ########

#### [3] check average temp and com of hot and cold regions ####

    compute  comhot   heatReg   com
    compute  comcoldL coolRegL  com
    compute  comcoldR coolRegR  com
    compute  compfhL  pfhleft   com
    compute  compfhR  pfhright  com

    compute  Thot   heatReg  temp
    compute  TcoldL coolRegL temp
    compute  TcoldR coolRegR temp
    compute  TpfhL  pfhleft  temp
    compute  TpfhR  pfhright temp

    fix monitorHotCold all ave/time 1 ${Nt} ${Nt} c_comhot[3] c_comcoldL[3] c_comcoldR[3] c_compfhL[3] c_compfhR[3] &
                                                  c_Thot      c_TcoldL      c_TcoldR      c_TpfhL      c_TpfhR      &
                                                  file out.comtemphotCold format "%15.5f"

#### end of [3] ########

########## END OF CHECKS DURING RUN ##########

    thermo_style    custom step temp pe ke etotal ecouple econserve
    thermo          ${Nt}
    thermo_modify   flush yes
    thermo_modify   format line "%d %15.3f %15.5f %15.5f %15.5f %15.5f %15.5f"

    dump 1 all custom ${Ndump} dump.nve.lammpstrj id type x y z vx vy vz
    dump_modify 1 sort id

# Write a restart file for continuation

    restart ${Nrst} restart.therm.*

    run ${Nitherm} start 0 stop ${Ntot}
    undump 1
    unfix monitorHotCold
    unfix qInOut
    unfix enStats
    unfix center 

    write_restart restart.step4

########## COLLECT THERMO -- Density, Temperature, Pressure ##########
########## WORKS PERFECTLY BUT IS SLOOOOOW ###########################

    # include in.collectThermo
