############################################################################################
# Combined LAMMPS input script for graphene-PFH system
# Generated by graphene_PFH_npt_workflow.sh
############################################################################################
log             log.combined
dimension       3
units           real  
boundary        p p p
atom_style      full
echo            both
processors      * * 1

variable grafboxlen equal 30.150000000000002
variable pfhboxlen  equal 62.5

variable shift1 equal 0.0
variable shift3 equal -46.325000000000001

variable xL equal -24.6
variable xH equal 24.6
variable yL equal -21.3042249330972
variable yH equal 21.3042249330972
variable zL equal -61.400000000000002
variable zH equal 61.400000000000002

region mybox block ${xL} ${xH} ${yL} ${yH} ${zL} ${zH} units box
create_box 21 mybox bond/types 2 angle/types 3 dihedral/types 3 extra/bond/per/atom 4 extra/angle/per/atom 6 extra/dihedral/per/atom 11

include in.varDefs
include in.forcefield

# Read data for the bottom graphene block.
read_data in.graphene add append offset 3 0 0 0 0 shift 0 0 ${shift3}
# Read data for the PFH slab.
read_data in.PFH add append offset 0 0 0 0 0 shift 0 0 ${shift1}
# Read data for the top graphene block (offset = SHEETS+2).
read_data in.graphene add append offset 12 0 0 0 0 shift 0 0 ${shift3}
group rotateSheet type  13 14 15 16 17 18 19 20 21
displace_atoms rotateSheet rotate 0 0 0 1 0 0 180

# charges for atoms in PFH
set type 1 charge 0.36      # C1
set type 2 charge 0.24      # C2
set type 3 charge -0.120    # F 
set type 4* charge 0.0000   # C-Tersoff

# Energy minimization
minimize 1.0e-6 1.0e-8 1000 10000

write_data combined_system.dat

quit
