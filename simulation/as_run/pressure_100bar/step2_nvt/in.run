############################################################################################
# LAMMPS input script for NPT simulation of combined graphene-water system
# Generated by graphene_water_npt_workflow.sh
############################################################################################
dimension       3
units           metal
boundary        p p p
atom_style      full
echo            both

bond_style      harmonic
angle_style     harmonic
dihedral_style  opls

read_data       ../step1_npt/config.end_of_npt
include         in.groups
# include         in.varDefs_shortRun
include         in.varDefs
include         in.forcefield

run_style       verlet
neighbor        3.0 bin
neigh_modify    every 10 delay 10 check yes one 10000

run 0

#############################################################
# Run the graphene water system in NVT at a fixed temperature 
#############################################################

reset_timestep 0
timestep 1e-3

fix  lwnvt  lw_all nvt temp ${temp} ${temp} $(100*dt)
fix  rwnvt  rw_all nvt temp ${temp} ${temp} $(100*dt)
fix  pfhnvt PFH    nvt temp ${temp} ${temp} $(100*dt)
fix  center all recenter INIT INIT INIT units box

run ${Ninvt}

unfix center
reset_timestep 0

include in.sheetSeps
include in.computePress

fix  center all recenter INIT INIT INIT units box

dump 1 all custom ${Ndump} dump.nvt.lammpstrj id type x y z vx vy vz
dump_modify 1 sort id

# Write a restart file for continuation
restart ${Nrst} restart.nvt.*

run ${Npnvt}
undump 1

write_data config.end_of_nvt

variable xL equal xlo
variable xH equal xhi

variable yL equal ylo
variable yH equal yhi

variable zL equal zlo
variable zH equal zhi

print "xlo xhi : ${xL}    ${xH}" 
print "ylo yhi : ${yL}    ${yH}" 
print "zlo zhi : ${zL}    ${zH}" 
