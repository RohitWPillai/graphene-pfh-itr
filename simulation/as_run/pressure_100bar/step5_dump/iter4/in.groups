# delete groups 
group coolRegL      delete 
group coolRegR      delete 
group wallright     delete 
group wallleft      delete 

# make groups for sdhf calculation [See sketch above]
group graf_pfhRight type 21 20 19 18 17 16 15 14 13
group graf_pfhLeft  type  4  5  6  7  8  9 10 11 12

# -- CHECK_SUM = 12 groups in total 

group lhotwall  intersect graf_pfhRight leftAtoms
group rcoolwall intersect graf_pfhRight rightAtoms 

group lcoolwall intersect graf_pfhLeft  leftAtoms  
group rhotwall  intersect graf_pfhLeft  rightAtoms

