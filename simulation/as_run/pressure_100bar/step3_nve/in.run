############################################################################################
# LAMMPS input script for NPT simulation of combined graphene-pfh system
# Generated by graphene_pfh_npt_workflow.sh
############################################################################################
dimension       3
units           metal
boundary        p p p
atom_style      full
echo            both

bond_style      harmonic
angle_style     harmonic
dihedral_style  opls

variable leftEdge   equal -2*${halfLz}      # left edge of the simulation box
variable rightEdge  equal  2*${halfLz}      # right edge of the simulation box 
variable leftcntr   equal   -${halfLz}      # center of the left graphene-pfh block
variable rightcntr  equal    ${halfLz}      # center of the right graphene-pfh block

variable xL         equal -${xH} 
variable yL         equal -${yH}
variable zL         equal  ${leftEdge}
variable zH         equal  ${rightEdge}

region mybox block ${xL} ${xH} ${yL} ${yH} ${zL} ${zH} units box
create_box 21 mybox bond/types 2 angle/types 3 dihedral/types 3 extra/bond/per/atom 4 extra/angle/per/atom 6 extra/dihedral/per/atom 11

# include         in.varDefs_shortRun
include         in.varDefs

read_data       ../step2_nvt/config.end_of_nvt add append offset 0 0 0 0 0 shift 0 0 -${halfLz}
read_data       ../step2_nvt/config.end_of_nvt add append offset 0 0 0 0 0 shift 0 0  ${halfLz}

include         in.forcefield
include         in.groups

run_style       verlet
neighbor        3.0 bin
neigh_modify    every 10 delay 10 check yes one 10000

run_style       verlet

run 0

##############################################################
# NVE : Simulate the system with no barostats or thermostats #
##############################################################

fix  pfhnve   PFH     nve    
fix  lwnve    lw_all  nve 
fix  rwnve    rw_all  nve 
fix  center   all     recenter INIT INIT INIT units box

compute lwmom  lw_all momentum 
compute rwmom  rw_all momentum 
compute pfhmom PFH    momentum 

fix momStats all ave/time 1 1 1 c_lwmom[1] c_lwmom[2] c_lwmom[3] &
                                c_rwmom[1] c_rwmom[2] c_rwmom[3] &
                                c_pfhmom[1] c_pfhmom[2] c_pfhmom[3] file out.mom

run 0

unfix momStats

velocity pfhleft  zero linear
velocity pfhleft  zero angular
velocity pfhright zero linear
velocity pfhright zero angular
velocity lw_all   zero linear
velocity lw_all   zero angular
velocity rw_all   zero linear
velocity rw_all   zero angular

fix momStats all ave/time 1 1 1 c_lwmom[1] c_lwmom[2] c_lwmom[3] &
                                c_rwmom[1] c_rwmom[2] c_rwmom[3] &
                                c_pfhmom[1] c_pfhmom[2] c_pfhmom[3] append out.mom

run 0

unfix momStats

thermo_style    custom step temp pe ke etotal 
thermo          ${Nt}
thermo_modify   flush yes
thermo_modify   format line "%d %15.3f %15.8e %15.8e %15.8e"              

uncompute lwmom
uncompute rwmom
uncompute pfhmom

reset_timestep 0

variable totE equal etotal
fix dumpEtot all ave/time 10000 1 10000 v_totE file out.etot format "%20.5f"

dump 1 all custom ${Ndump} dump.nve.lammpstrj id type x y z vx vy vz
dump_modify 1 sort id

# Write a restart file for continuation
restart ${Nrst} restart.nve.*

timestep 1e-3
run ${Ninve_long}

include in.computePress

run ${Ninve_sample}
undump 1

unfix  pfhnve
unfix  lwnve
unfix  rwnve
unfix  center
unfix  dumpEtot
